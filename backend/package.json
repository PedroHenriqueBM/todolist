{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "app:setup": "npm i && npm run prisma:generate && npm run typedoc:generate && npm run app:build",
    "app:test": "jest",
    "app:build": "tsc && cpx \"./src/infraestructure/EnvModule/EnvFiles/**/*\" dist/src/infraestructure/EnvModule/EnvFiles && cpx \"./src/infraestructure/EnvModule/EnvFiles/.env.*\" dist/src/infraestructure/EnvModule/EnvFiles",
    "app:dev": "cross-env NODE_ENV=development nodemon",
    "app:prod": "cross-env NODE_ENV=production node dist/index.js",
    "app:runDatabaseContainer": "docker run -d -p 3307:3306 meu-mysql",
    "app:buildDatabaseContainer": "docker build -t meu-mysql ./devops/dockerfile/Mysql",
    "app:setupDatabaseContainer": "npm run app:buildDatabaseContainer && npm run app:runDatabaseContainer",
    "prisma:generate": "dotenv -e ./src/infraestructure/EnvModule/EnvFiles/.env.$npm_config_env prisma generate",
    "prisma:migrate": "dotenv -e ./src/infraestructure/EnvModule/EnvFiles/.env.$npm_config_env prisma migrate dev --name init",
    "typedoc:generate": "npx typedoc"
  },
  "keywords": [],
  "author": "pedro.brrs.mendonca@gmail.com",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cpx": "^1.5.0",
    "cross-env": "^10.0.0",
    "dotenv-cli": "^10.0.0",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "prisma": "^6.15.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.12",
    "typescript": "^5.9.2"
  }
}

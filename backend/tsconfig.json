{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
  "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
